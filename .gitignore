# ---------------------------------------------------------------------------
# iTelemetry v3 — files that must NOT be committed
# ---------------------------------------------------------------------------

# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
develop-eggs/

# Virtual environments
venv/
.venv/
env/
myvenv/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs (may contain runtime/auth details — never commit)
*.log

# Secrets & local environment (never commit)
.env
.env.*
*.pem
*.pfx
*.key
*.pkcs12
*.p12
local.settings.json

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
*.swp

# Docker local overrides
docker-compose.override.yml
